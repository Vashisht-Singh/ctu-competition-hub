# ==========================================
# CTU Competition Hub - Environment Configuration
# CT University, Ludhiana, Punjab, India
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can provide a local MongoDB URI or MongoDB Atlas URI:
# e.g., mongodb://127.0.0.1:27017/ctu_competition_hub
MONGODB_URI=mongodb://127.0.0.1:27017/ctu_competition_hub

# Embedded Mongo Memory Server:
# Set to 'true' to run fully embedded zero-configuration in-memory database
USE_IN_MEMORY_DB=false

# JWT Secret Keys
JWT_SECRET=ctu_super_secure_jwt_secret_key_2026_dsw_competition_hub
JWT_REFRESH_SECRET=ctu_super_secure_refresh_secret_key_2026_dsw_competition_hub

# Client URL
CLIENT_URL=http://localhost:5173
